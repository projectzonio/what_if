<Project Sdk="Microsoft.NET.Sdk">
  <!-- RG-177 spike: What If planet anchors (settlements on the planet surface + road corridors in global coordinates, segments with pinned joints).
       netstandard2.1, no package references, no Unity types. C# 8. Uses the WorldGen vertical-curve solver through its public RG-177 entry. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>WhatIf.Planet.Anchors</AssemblyName>
    <RootNamespace>WhatIf.Planet.Anchors</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WhatIf.Planet\WhatIf.Planet.csproj" />
    <ProjectReference Include="..\WhatIf.Planet.Surface\WhatIf.Planet.Surface.csproj" />
    <ProjectReference Include="..\WhatIf.WorldGen\WhatIf.WorldGen.csproj" />
    <ProjectReference Include="..\WhatIf.Planet.WorldGen\WhatIf.Planet.WorldGen.csproj" />
  </ItemGroup>
</Project>
