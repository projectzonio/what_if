<Project Sdk="Microsoft.NET.Sdk">
  <!-- RG-172: What If planet streaming runtime (Unity-free): wanted sets, region/sector caches, 2 background workers, far layer feed.
       netstandard2.1, no packages, no Unity types. C# 8. -->
