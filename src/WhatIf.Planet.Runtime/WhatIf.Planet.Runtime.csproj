    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>WhatIf.Planet.Runtime</AssemblyName>
    <RootNamespace>WhatIf.Planet.Runtime</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WhatIf.Planet\WhatIf.Planet.csproj" />
    <ProjectReference Include="..\WhatIf.Planet.WorldGen\WhatIf.Planet.WorldGen.csproj" />
    <ProjectReference Include="..\WhatIf.Planet.FarLayer\WhatIf.Planet.FarLayer.csproj" />
  </ItemGroup>
</Project>
