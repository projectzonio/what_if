{
  "schema": "nightracer.worldgen.kn5-roadside-classes.v1",
  "note": "RG-108: regex table for the roadside class of a visual node. Matched case-insensitively against 'node|material|shader' (node name, material name and the KN5 shader of the object that was hit; the Unity URP shader is useless here). Generic words and generic AC shader names only, no map-specific names (ADR-032); the first class in 'order' that matches wins, 'default' otherwise. Classes: tree, lamp, sign, guardrail, building, other; 'ignore' = backdrop / sky / water, no roadside object (not counted). Assumption: an alpha-tested KN5 shader (ksPerPixelAT*, ksTree, ksGrass) means vegetation cards (foliage, bushes); fences and wires use it too, so it can over-count 'tree'.",
  "order": [
    "ignore",
    "guardrail",
    "lamp",
    "sign",
    "building",
    "tree"
  ],
  "default": "other",
  "classes": {
    "guardrail": [
      "guard",
      "rail",
      "barrier",
      "crash",
      "armco",
      "fence",
      "jersey",
      "^\\d*wall"
    ],
    "tree": [
      "tree",
      "bush",
      "shrub",
      "foliage",
      "leaf",
      "leaves",
      "pine",
      "palm",
      "plant",
      "forest",
      "hedge",
      "veget",
      "cedar",
      "cypress",
      "bamboo",
      "grass",
      "\\|ks(Tree|Grass|PerPixelAT)"
    ],
    "lamp": [
      "lamp",
      "light",
      "lantern",
      "street_?l",
      "bulb",
      "luminaire"
    ],
    "sign": [
      "sign",
      "board",
      "billboard",
      "signal",
      "traffic",
      "bollard",
      "pole",
      "post",
      "arrow",
      "banner",
      "marker",
      "cone",
      "mirror"
    ],
    "building": [
      "build",
      "house",
      "bldg",
      "apart",
      "shop",
      "store",
      "roof",
      "tower",
      "home",
      "hut",
      "garage",
      "tunnel",
      "bridge",
      "pillar",
      "pier",
      "concrete",
      "window",
      "facade",
      "wall",
      "stair",
      "tile",
      "brick",
      "station",
      "shed",
      "factory",
      "gate",
      "kawara",
      "shingle"
    ],
    "ignore": [
      "horizon",
      "skydome",
      "backdrop",
      "\\bsky",
      "water",
      "\\|ksSky",
      "^(vis)?road",
      "^(vis)?pit",
      "tarmac",
      "asphalt",
      "kerb|curb",
      "marking",
      "skid",
      "crack",
      "gravel",
      "\\bsand",
      "dirt",
      "\\bmud",
      "soil",
      "terrain",
      "\\bground",
      "pavement",
      "sidewalk"
    ]
  },
  "ignore_for_tunnel_cover": [
    "tree",
    "lamp",
    "sign",
    "ignore"
  ],
  "ignore_for_bridge_ground": [
    "tree",
    "lamp",
    "sign",
    "guardrail",
    "ignore"
  ]
}
